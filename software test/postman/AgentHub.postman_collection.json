    {
      "name": "3. 会话（核心：发送→执行→回答）",
      "item": [
        {
          "name": "GET /api/sessions（列出）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sessions?limit=10"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('[会话列表] 状态码 200', function () { pm.response.to.have.status(200); });"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "POST /api/sessions（新建）",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/sessions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentId\": {{agentId}},\n  \"title\": \"Postman 测试对话\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('[新建会话] 状态码 200', function () { pm.response.to.have.status(200); });",
                "pm.test('[新建会话] 返回 id', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json).to.have.property('id');",
                "});",
                "const json = pm.response.json();",
                "pm.environment.set('sessionId', json.id);",
                "console.log('sessionId =', json.id);"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "GET /api/sessions/{sid}（详情含消息）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('[会话详情] 状态码 200', function () { pm.response.to.have.status(200); });",
                "pm.test('[会话详情] 有 messages 数组', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.messages).to.be.an('array');",
                "});"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "POST /api/sessions/{sid}/send（核心：目标→执行→回答）",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}/send",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"调研 2026 年国内宠物智能硬件市场，输出机会点与进入建议\"\n}"
            },
            "description": "最核心的接口：后端自动匹配技能、规划步骤、逐步执行、出自然语言回答。\n\n返回两种可能：\n- message=completed：直接完成，最后一条 assistant 消息就是回答\n- message=waiting_approval：遇到敏感步骤（目标里有\"发送\"、\"邮件\"等），要调 approve 继续"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('[send 目标] 状态码 200', function () { pm.response.to.have.status(200); });",
                "pm.test('[send 目标] message 是 completed 或 waiting_approval', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.message).to.be.oneOf(['completed', 'waiting_approval']);",
                "});",
                "pm.test('[send 目标] 有最终回答内容', function () {",
                "  const json = pm.response.json();",
                "  const lastMsg = (json.messages || []).filter(m => m.role === 'assistant').pop();",
                "  pm.expect(lastMsg && lastMsg.content).to.be.a('string').and.not.empty;",
                "});",
                "// 从最后一条 assistant 消息里提取第一个交付物 id，给下载接口用",
                "const json = pm.response.json();",
                "const lastMsg = (json.messages || []).filter(m => m.role === 'assistant').pop();",
                "const arts = lastMsg?.data?.artifacts || [];",
                "if (arts.length > 0) {",
                "  pm.environment.set('artifactId', arts[0].id);",
                "  console.log('artifactId =', arts[0].id);",
                "}"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "POST /api/sessions/{sid}/approve（授权敏感步骤）",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/sessions/{{sessionId}}/approve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"内容已确认，允许发送\"\n}"
            },
            "description": "只有当 send 返回 message=waiting_approval 时才需要调这个。批准后继续执行剩余步骤，最终出完整回答。"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('[授权] 状态码 200 或 400（没有待授权步骤时）', function () {",
                "  pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                "});"
              ]
            }
          }],
          "response": []
        }
      ]
    },
