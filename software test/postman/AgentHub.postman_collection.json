{
  "info": {
    "name": "AgentHub · API 接口测试",
    "_postman_id": "agenthub-v5",
    "description": "灵枢 AgentHub 接口测试集合，24 个接口，按功能分组。登录注册 4 个、智能体 3 个、会话 5 个、定时任务 4 个、交付物下载 1 个、管理后台 6 个（仅 admin有），每个请求带三层断言（状态码 + 业务码 + 关键字段），并自动提取环境变量传递给后续依赖请求。\n\n测试账号：tester / tester123（admin / admin123）\n运行顺序：从上往下依次跑完 24 个请求即可",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "0. 健康检查（不需要登录）",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "// 断言 1：状态码 200",
                "pm.test('[健康检查] 状态码 200', function () {",
                "  pm.response.to.have.status(200);",
                "});",
                "// 断言 2：必须有 status 字段且值为 ok",
                "pm.test('[健康检查] status = ok', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.status).to.eql('ok');",
                "});"
              ]
            }
          }],
          "response": []
        }
      ]
    },
    {
      "name": "1. 登录注册",
      "item": [
        {
          "name": "GET /api/captcha",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/captcha",
            "description": "注册前先调这个拿验证码 id 和图片。返回的 id 填到注册请求的 captchaId 字段。"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('[验证码] 状态码 200', function () { pm.response.to.have.status(200); });",
                "pm.test('[验证码] 返回 id 和 image', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json).to.have.property('id');",
                "  pm.expect(json).to.have.property('image');",
                "});",
                "// 注册需要的 captchaId 就是后端返回的 id 字段",
                "const json = pm.response.json();",
                "pm.environment.set('captchaId', json.id);",
                "// 验证码图片是 base64，展示给人眼看，不需要传给后端",
                "console.log('captchaId =', json.id);"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "POST /api/auth/login（tester）",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"tester\",\n  \"password\": \"tester123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('[登录 tester] 状态码 200', function () { pm.response.to.have.status(200); });",
                "pm.test('[登录 tester] 返回 token', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                "});",
                "pm.test('[登录 tester] username = tester', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.username).to.eql('tester');",
                "});",
                "const json = pm.response.json();",
                "pm.environment.set('token', json.token);",
                "console.log('token set:', json.token?.substring(0,20) + '...');"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "POST /api/auth/login（admin）",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('[登录 admin] 状态码 200', function () { pm.response.to.have.status(200); });",
                "pm.test('[登录 admin] 返回 token', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                "});",
                "const json = pm.response.json();",
                "pm.environment.set('adminToken', json.token);",
                "console.log('adminToken set');"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "POST /api/auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser01\",\n  \"password\": \"123456\",\n  \"captchaId\": \"{{captchaId}}\",\n  \"captchaCode\": \"{{captchaCode}}\"\n}"
            },
            "description": "需要先调 GET /captcha 拿到验证码 id 和图片，验证码 5 分钟有效，一次性使用。"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('[注册] 状态码 200 或 400（验证码过期）', function () {",
                "  pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                "});"
              ]
            }
          }],
          "response": []
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('[当前用户] 状态码 200', function () { pm.response.to.have.status(200); });",
                "pm.test('[当前用户] 有 username 字段', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.username).to.eql('tester');",
                "});"
              ]
            }
          }],
          "response": []
        }
      ]
    },
    {
      "name": "2. 智能体",
      "item": [
        {
          "name": "GET /api/agents（列出）",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/agents"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('[智能体列表] 状态码 200', function () { pm.response.to.have.status(200); });",
                "pm.test('[智能体列表] 返回 agents 数组且至少 1 个', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.agents).to.be.an('array').and.to.have.length.of.at.least(1);",
                "});",
                "const json = pm.response.json();",
                "if (json.agents && json.agents.length > 0) {",
