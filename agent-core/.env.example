# 复制为 .env（或直接在系统环境变量里设置），切勿把真实 Key 提交到仓库
DEEPSEEK_API_KEY=sk-你的真实Key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# mock=确定性可复现(AI评测/CI) | live=真实DeepSeek | auto=有Key走live否则mock
AGENT_MODE=auto

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---- MySQL 3307（连不上时自动降级 SQLite）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=nexus_agent
DB_FALLBACK_SQLITE=1

# ---- RAG 与编排 ----
RAG_TOP_K=3
MAX_STEPS=6
CACHE_TTL=600

# ---- 服务与鉴权 ----
API_HOST=127.0.0.1
API_PORT=8000
JWT_SECRET=agenthub-local-dev-secret-change-me
JWT_TTL=86400
